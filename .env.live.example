# Template for `.env.live`, the credentials the live end-to-end test reads
# (tests/live/test_live_workspace_run.py). Copy it to `.env.live`, fill in a
# real key, and leave that copy untracked — `.gitignore` already covers it.
#
# The test is the only thing in this repository that spends money, so it does
# not run unless it is asked for by name:
#
#   uv run pytest tests/live -m live
#
# A key that is present but wrong fails the run rather than skipping it: a
# credential problem is a result, not an absence.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Optional. The model every persona in the live run uses. Defaults to the
# value below, which is DeepSeek's fast tier — the run delegates once and
# reads one file, so nothing about it needs a reasoning model.
# ROTARIS_LIVE_MODEL_ID=deepseek-v4-flash
