{
  "name": "rotaris-crw",
  "private": true,
  "version": "0.0.0",
  "description": "Rotaris — one Electron desktop application. Clean-room rewrite.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node tools/check-line-endings.mjs && node tools/check-request-log.mjs && node tools/check-theme-colours.mjs && node tools/check-ui-language.mjs && eslint .",
    "mockup": "node tools/mockup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "symbols": "node tools/symbol-artifact/generate.mjs",
    "directive-proof": "node apps/desktop/scripts/directive-proof.mjs",
    "dev": "pnpm --filter @rotaris/desktop dev",
    "build": "pnpm --filter @rotaris/desktop build",
    "theme-proof": "node apps/desktop/scripts/theme-proof.mjs",
    "part-h-proof": "node apps/desktop/scripts/part-h-proof.mjs",
    "config-proof": "node apps/desktop/scripts/config-proof.mjs",
    "plan-gate-proof": "node apps/desktop/scripts/plan-gate-proof.mjs",
    "part-j-proof": "node apps/desktop/scripts/part-j-proof.mjs",
    "sandbox-proof": "node apps/desktop/scripts/sandbox-proof.mjs",
    "slice-proof": "node apps/desktop/scripts/slice-proof.mjs",
    "overview-proof": "node apps/desktop/scripts/overview-proof.mjs",
    "fetch-proof": "node apps/desktop/scripts/fetch-proof.mjs",
    "git-proof": "node apps/desktop/scripts/git-proof.mjs",
    "resilience-proof": "node apps/desktop/scripts/resilience-proof.mjs",
    "compression-proof": "node apps/desktop/scripts/compression-proof.mjs",
    "checkpoint-proof": "node apps/desktop/scripts/checkpoint-proof.mjs",
    "sessions-proof": "node apps/desktop/scripts/sessions-proof.mjs",
    "mcp-proof": "node apps/desktop/scripts/mcp-proof.mjs",
    "mission-proof": "node apps/desktop/scripts/mission-proof.mjs",
    "code-intel:bundle": "node apps/desktop/scripts/code-intelligence/bundle.mjs",
    "code-intel:manifest": "node apps/desktop/scripts/code-intelligence/manifest.mjs",
    "code-intel-proof": "node apps/desktop/scripts/code-intel-proof.mjs",
    "notice-proof": "node apps/desktop/scripts/notice-proof.mjs",
    "library-proof": "node apps/desktop/scripts/library-proof.mjs",
    "improvements-proof": "node apps/desktop/scripts/improvements-proof.mjs",
    "retrospective-proof": "node apps/desktop/scripts/retrospective-proof.mjs",
    "artifacts-proof": "node apps/desktop/scripts/artifacts-proof.mjs",
    "palette-proof": "node apps/desktop/scripts/palette-proof.mjs",
    "transcript-proof": "node apps/desktop/scripts/transcript-proof.mjs",
    "rows-proof": "node apps/desktop/scripts/rows-proof.mjs",
    "composer-proof": "node apps/desktop/scripts/composer-proof.mjs",
    "questions-proof": "node apps/desktop/scripts/questions-proof.mjs",
    "todo-proof": "node apps/desktop/scripts/todo-proof.mjs",
    "attachments-proof": "node apps/desktop/scripts/attachments-proof.mjs",
    "settings-proof": "node apps/desktop/scripts/settings-proof.mjs",
    "skills-proof": "node apps/desktop/scripts/skills-proof.mjs",
    "init-proof": "node apps/desktop/scripts/init-proof.mjs",
    "requirements-proof": "node apps/desktop/scripts/requirements-proof.mjs",
    "traceability-proof": "node apps/desktop/scripts/traceability-proof.mjs",
    "terminal-stream-proof": "node apps/desktop/scripts/terminal-stream-proof.mjs",
    "terminal-proof": "node apps/desktop/scripts/terminal-proof.mjs",
    "slash-proof": "node apps/desktop/scripts/slash-proof.mjs",
    "requirements-runs-proof": "node apps/desktop/scripts/requirements-runs-proof.mjs",
    "chat-controls-proof": "node apps/desktop/scripts/chat-controls-proof.mjs",
    "live-run": "node apps/desktop/scripts/live-run.mjs",
    "autopsy": "node apps/desktop/scripts/autopsy.mjs",
    "app:drive": "node apps/desktop/scripts/drive.mjs",
    "driver-proof": "node apps/desktop/scripts/driver-proof.mjs",
    "layout-proof": "node apps/desktop/scripts/layout-proof.mjs",
    "workspace-proof": "node apps/desktop/scripts/workspace-proof.mjs",
    "ui-audit": "node apps/desktop/scripts/ui-audit.mjs",
    "ui-review": "node apps/desktop/scripts/ui-review.mjs",
    "migrate:ui-primitives": "node tools/migrate-ui-primitives.mjs",
    "theme-proof:counterfactual:text": "node apps/desktop/scripts/theme-proof.mjs --counterfactual=text",
    "theme-proof:counterfactual:focus": "node apps/desktop/scripts/theme-proof.mjs --counterfactual=focus",
    "package": "pnpm --filter @rotaris/desktop package",
    "check": "pnpm symbols && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
