{
  // The processes that have Node (R-091, hardening.md §3.5 row 5; ADR-0002): main, the preload and the workspace service,
  // and the packages the processes load — Node's types and no DOM, so a `window` or a `document` written here fails the
  // typecheck. The run host and `agent-tools` are `tsconfig.run-host.json`'s, and every test is the tests project's.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": [
    "packages/platform/src/**/*.ts",
    "packages/store/src/**/*.ts",
    "packages/config/src/**/*.ts",
    "packages/model/src/**/*.ts",
    "packages/hooks/src/**/*.ts",
    "packages/providers/src/**/*.ts",
    "packages/engine/src/**/*.ts",
    "packages/mcp/src/**/*.ts",
    "packages/workspace/src/**/*.ts",
    "packages/shell/src/**/*.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.ts",
    "apps/desktop/src/workspace-service/**/*.ts",
    "tools/release-naming/src/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/out", "**/*.test.ts", "**/*.test.tsx", "**/*.test-support.ts"]
}
