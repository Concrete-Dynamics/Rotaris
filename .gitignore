.proof/
# Agent tooling is local, with one exception: the skills under `.claude/skills/` are repository content —
# procedures the work depends on, which a fresh clone must carry. The directory itself is listed as
# `.claude/*` rather than `.claude/`, because git will not descend into an excluded directory and a
# negation inside one is never read.
.claude/*
!.claude/skills/
.serena/
.tokensave/

node_modules/
dist/
out/
release/
*.tsbuildinfo
*.log
.theme-proof/
.part-h-proof/
.config-proof/
.part-j-proof/

# Generated by tools/symbol-artifact from docs/spec (ADR-0040 #4, ADR-0056).
packages/kernel/src/generated/
.slice-proof/
.overview-proof/
.fetch-proof/
.git-proof/
.resilience-proof/
.checkpoint-proof/
.sessions-proof/
.mcp-proof/
.notice-proof/
.palette-proof/
.mission-proof/
.artifacts-proof/
.code-intel-proof/
.library-proof/
.transcript-proof/
.rows-proof/
.composer-proof/
.questions-proof/
.todo-proof/
.attachments-proof/
.slash-proof/
.settings-proof/
.compression-proof/
# Part AM
.terminal-proof/
# ADR-0035 (Part T): the bundled code-intelligence runtime is built by `pnpm code-intel:bundle` from committed pins, never committed.
apps/desktop/resources/code-intelligence/
apps/desktop/.cache/
# Part AK
.requirements-proof/
# Part AK' renamed `delivery-proof` to `requirements-proof` and moved this line with it, which left the old
# evidence directory on disk and unignored; a blanket `git add -A` at merge 2 then tracked it.
.delivery-proof/
# Part AJ
.traceability-proof/

# Part AL
.terminal-stream-proof/
# Part AP
.requirements-runs-proof/

# Part AO
.chat-controls-proof/

# The live run (`pnpm live-run`): its evidence, and nothing of the sandbox it works in.
.live-run/

# The driver (`pnpm app:drive`, `pnpm driver-proof`): the scratch profile a driven app runs against, and the proof's evidence.
.drive/
.driver-proof/
.layout-proof/
# `pnpm ui-audit`: a PNG per view and per overlay at every size, plus report.json. Evidence, never content.
.ui-audit/

# the token proxy's local history database — a tool artifact, never repository content
rtk/
.workspace-proof/