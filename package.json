    "package": "pnpm --filter @rotaris/desktop package",
    "release:guard": "node tools/release-guard/cli.mjs",
    "release:pipeline": "node tools/release-pipeline/cli.mjs",
    "notices": "node tools/notices/generate.mjs",
    "build-id": "node tools/build-id/write.mjs",
    "req-coverage": "node tools/requirement-coverage/coverage.mjs",
    "verify:plan": "node tools/verify-plan/plan.mjs",
    "local-model:apply": "node tools/local-model/apply.mjs",
