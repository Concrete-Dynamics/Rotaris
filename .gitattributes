# Line endings are decided here, not by whatever `core.autocrlf` a machine happens
# to carry. Every text blob in this repository is LF, and every checkout gets LF
# on Windows as readily as on Linux, so a scripted edit never has to guess what
# the working copy holds and a diff never reports a whole file for its endings.
# `tools/check-line-endings.mjs` fails `pnpm lint` if a CRLF blob is ever staged.
* text=auto eol=lf

# Explicit for the extensions this repository actually holds, so a file git's own
# heuristic misjudges is still normalised.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.tsv   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.npmrc text eol=lf
.gitignore      text eol=lf
.editorconfig   text eol=lf
.gitattributes  text eol=lf

# No longer true (2026-10-06): "`packages/config/src/mcp/environment.ts` holds a
# literal NUL byte as a map-key separator, so git's binary heuristic reads it as
# binary and would leave it out of `text=auto`. Declared here so normalisation
# reaches it; git still reports it `-text` and may show a diff of it as a blob,
# which is an argument for writing that separator as a `\u0000` escape in the
# source one day." That day came: `mergeSecrets` writes the separator as the
# escape `\u0000`, the file holds no NUL byte, and git reads it as text
# (docs/defects/fixed/the-secret-merge-keys-carry-literal-nul-bytes-so-git-treats-their-file-as-binary.md).
# The file's own line `packages/config/src/mcp/environment.ts text eol=lf` is
# dropped: `*.ts text eol=lf` above already gives it the same attributes.

# cmd.exe is the one consumer that genuinely needs CRLF: a batch file with LF
# endings can mis-handle labels and `goto`. None are tracked today; if one is,
# it gets CRLF on every platform.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary. Never normalised, never diffed as text.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.db    binary
*.sqlite binary
*.sqlite3 binary
*.node  binary
*.exe   binary
*.dll   binary
*.wasm  binary

# Generated, and large. Still text, but not worth reading in a diff.
pnpm-lock.yaml text eol=lf -diff
