{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The language alone (R-091, hardening.md §3.5 row 5): each project adds the host it runs in — the DOM for the
    // renderer's, Node's types for the processes that have Node, neither for the code both sides share.
    "lib": ["ES2024"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    // Not `noPropertyAccessFromIndexSignature`: it would only respell `record.key` as `record['key']` across the code,
    // with `noUncheckedIndexedAccess` already making both reads `T | undefined` — churn without safety (R-091).
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@rotaris/kernel": ["./packages/kernel/src/index.ts"],
      "@rotaris/contracts": ["./packages/contracts/src/index.ts"],
      "@rotaris/platform": ["./packages/platform/src/index.ts"],
      "@rotaris/config": ["./packages/config/src/index.ts"],
      "@rotaris/hooks": ["./packages/hooks/src/index.ts"],
      "@rotaris/providers": ["./packages/providers/src/index.ts"],
      "@rotaris/store": ["./packages/store/src/index.ts"],
      "@rotaris/engine": ["./packages/engine/src/index.ts"],
      "@rotaris/agent-tools": ["./packages/agent-tools/src/index.ts"],
      "@rotaris/model": ["./packages/model/src/index.ts"],
      "@rotaris/mcp": ["./packages/mcp/src/index.ts"],
      "@rotaris/workspace": ["./packages/workspace/src/index.ts"],
      "@rotaris/shell": ["./packages/shell/src/index.ts"],
      "@rotaris/ui-core": ["./packages/ui-core/src/index.ts"],
      "@rotaris/ui": ["./packages/ui/src/index.ts"],
      "@rotaris/release-naming": ["./tools/release-naming/src/index.ts"]
    }
  }
}
