# One flat node_modules so electron-builder and the native bindings resolve the
# same tree the dev server does (ADR-0056: the installer and the portable carry
# one win-unpacked tree, and it must be the tree that was tested).
#
# pnpm 11 reads only registry, authentication and network keys from this file;
# its own settings, nodeLinker and engineStrict among them, are read from
# pnpm-workspace.yaml (measured 2026-11-01 for engine-strict: a line here is
# inert). pnpm ignores the two lines below; they stay as they were.
node-linker=hoisted
strict-peer-dependencies=false
