    "autopsy": "node apps/desktop/scripts/autopsy.mjs",
    "evidence": "node apps/desktop/scripts/evidence.mjs",
    "app:drive": "node apps/desktop/scripts/drive.mjs",
    "driver-proof": "node apps/desktop/scripts/driver-proof.mjs",
    "updater-proof": "node apps/desktop/scripts/updater-proof.mjs",
    "exit-trace-proof": "node apps/desktop/scripts/exit-trace-proof.mjs",
