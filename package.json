{
  "name": "rotaris-crw",
  "private": true,
  "version": "0.0.0",
  "description": "Rotaris — one Electron desktop application. Clean-room rewrite.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node tools/check-theme-colours.mjs && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "symbols": "node tools/symbol-artifact/generate.mjs",
    "dev": "pnpm --filter @rotaris/desktop dev",
    "build": "pnpm --filter @rotaris/desktop build",
    "theme-proof": "node apps/desktop/scripts/theme-proof.mjs",
    "part-h-proof": "node apps/desktop/scripts/part-h-proof.mjs",
    "config-proof": "node apps/desktop/scripts/config-proof.mjs",
    "part-j-proof": "node apps/desktop/scripts/part-j-proof.mjs",
    "slice-proof": "node apps/desktop/scripts/slice-proof.mjs",
    "overview-proof": "node apps/desktop/scripts/overview-proof.mjs",
    "fetch-proof": "node apps/desktop/scripts/fetch-proof.mjs",
    "git-proof": "node apps/desktop/scripts/git-proof.mjs",
    "resilience-proof": "node apps/desktop/scripts/resilience-proof.mjs",
    "checkpoint-proof": "node apps/desktop/scripts/checkpoint-proof.mjs",
    "sessions-proof": "node apps/desktop/scripts/sessions-proof.mjs",
    "mcp-proof": "node apps/desktop/scripts/mcp-proof.mjs",
    "mission-proof": "node apps/desktop/scripts/mission-proof.mjs",
    "code-intel:bundle": "node apps/desktop/scripts/code-intelligence/bundle.mjs",
    "code-intel:manifest": "node apps/desktop/scripts/code-intelligence/manifest.mjs",
    "code-intel-proof": "node apps/desktop/scripts/code-intel-proof.mjs",
    "notice-proof": "node apps/desktop/scripts/notice-proof.mjs",
    "library-proof": "node apps/desktop/scripts/library-proof.mjs",
    "artifacts-proof": "node apps/desktop/scripts/artifacts-proof.mjs",
    "palette-proof": "node apps/desktop/scripts/palette-proof.mjs",
    "transcript-proof": "node apps/desktop/scripts/transcript-proof.mjs",
    "rows-proof": "node apps/desktop/scripts/rows-proof.mjs",
    "composer-proof": "node apps/desktop/scripts/composer-proof.mjs",
    "questions-proof": "node apps/desktop/scripts/questions-proof.mjs",
    "todo-proof": "node apps/desktop/scripts/todo-proof.mjs",
    "settings-proof": "node apps/desktop/scripts/settings-proof.mjs",
    "theme-proof:counterfactual:text": "node apps/desktop/scripts/theme-proof.mjs --counterfactual=text",
    "theme-proof:counterfactual:focus": "node apps/desktop/scripts/theme-proof.mjs --counterfactual=focus",
    "package": "pnpm --filter @rotaris/desktop package",
    "check": "pnpm symbols && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
