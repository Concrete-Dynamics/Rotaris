{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rotaris (Windows)",
            "type": "debugpy",
            "request": "launch",
            "module": "rotaris",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "${workspaceFolder}"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "uv sync rotaris",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Rotaris (Linux)",
            "type": "debugpy",
            "request": "launch",
            "module": "rotaris",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "args": [
                "${workspaceFolder}"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "uv sync rotaris",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}